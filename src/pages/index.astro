---
// Homepage — link-tree style front door: a short "Hey, I'm Maria" intro with
// a photo, then four destination cards (rewritten September 2026 from the
// old "three universes" grid — adds a 1:1 coaching card and a Better Than
// Fine card, drops the Regulér collaboration box). Site nav + logo live in
// the global Header; contact lives in the global Footer. The substantive
// content lives on the linked pages/sites.
import Layout from '../layouts/Layout.astro';
import Langs from '../components/Langs.astro';
import maria from '../assets/maria-grass-seated.jpg';
import { Image } from 'astro:assets';

// Reuses the same banner already saved for /staffroom — same image, small
// thumbnail here.
import betterThanFineThumb from '../assets/staffroom/staffroom-header.png';
import fromFearToClarityThumb from '../assets/homepage/from-fear-to-clarity.jpg';
import coachingThumb from '../assets/homepage/coaching-card.jpg';
import brandsThumb from '../assets/homepage/brands-card.jpg';

const cards = [
    {
        tag: 'Free community',
        title: 'Better Than Fine',
        body: 'A free community for women who are performing fine and know, privately, that performing fine and actually feeling fine are not the same thing. Body-based practices. Real conversations. A framework for figuring out who you are when you’re not performing.',
        cta: 'Join the community',
        href: 'https://www.skool.com/thestaffroom',
        external: true,
        thumb: betterThanFineThumb,
        thumbAlt: 'Better Than Fine',
    },
    {
        tag: 'Free newsletter',
        title: 'From Fear to Clarity',
        body: 'Weekly essays and practices on identity, the nervous system, and what happens when you stop performing fine. For women who are still going, and privately asking if this is all there is.',
        cta: 'Read the essays',
        href: 'https://mariamontserratmaria.substack.com/',
        external: true,
        thumb: fromFearToClarityThumb,
        thumbAlt: 'From Fear to Clarity — Maria’s Substack newsletter',
    },
    {
        tag: '1:1 work',
        title: 'Mindfulness and yoga coaching',
        body: 'One-to-one work using yoga, mindfulness, and somatic practices to help you hear yourself clearly and figure out what you actually want. Not a programme. A direct line.',
        cta: 'Work with me',
        href: 'https://wa.me/4540305519?text=Hi%20Maria%2C%20I%27m%20interested%20in%201%3A1%20coaching',
        external: true,
        thumb: coachingThumb,
        thumbAlt: 'Maria in a yoga pose, hands together at heart centre',
    },
    {
        tag: 'For brands',
        title: 'UGC and content creation',
        body: 'Conversion-focused content in English, Spanish, and Danish. Wellness, lifestyle, and consumer brands. Worked with brands across Europe.',
        cta: 'See my work',
        href: '/brands',
        external: false,
        thumb: brandsThumb,
        thumbAlt: 'Maria smiling outdoors',
    },
];
---

<Layout
    title="Maria Montserrat — Yoga Instructor, Mindfulness Coach & Content Creator"
    description="Hey, I'm Maria — a yoga instructor, mindfulness coach, and nervous system practitioner based in Copenhagen, working with women who perform brilliantly and go blank when asked who they are outside of it. Trilingual (EN · ES · DA) content creator."
>
    <!-- ============================ INTRO ============================ -->
    <section class="relative overflow-hidden">
        <div class="absolute inset-0 -z-20 bg-primary-100"></div>

        <div class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 py-16 md:grid-cols-12 md:gap-16 md:px-10 md:py-24">
            <!-- Copy -->
            <div class="md:col-span-7">
                <p class="fade-up flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.35em] text-primary-800">
                    Copenhagen <Langs class="text-base tracking-normal" />
                </p>
                <h1 class="fade-up-delay-1 mt-6 font-display text-5xl leading-[1.05] text-stone-900 sm:text-6xl md:text-7xl">
                    Hey, I'm <em class="font-normal text-primary-800">Maria</em>.
                </h1>
                <p class="fade-up-delay-2 mt-8 max-w-xl text-lg leading-relaxed text-stone-800 md:text-xl">
                    Mexican-born, Denmark-based. Yoga instructor, mindfulness coach, and
                    nervous system practitioner. I work with women who are performing
                    brilliantly… and going blank when asked who they are outside of it.
                </p>
                <p class="fade-up-delay-3 mt-6 text-sm font-semibold uppercase tracking-widest text-stone-600">
                    Pick the path that fits you ↓
                </p>
            </div>

            <!-- Photo -->
            <div class="fade-up-delay-2 relative md:col-span-5">
                <div class="relative mx-auto max-w-sm md:max-w-none">
                    <div class="absolute -inset-4 -z-10 bg-accent-500" style="border-radius: 62% 38% 56% 44% / 48% 60% 40% 52%;"></div>
                    <div class="relative overflow-hidden shadow-2xl shadow-primary-900/20" style="border-radius: 62% 38% 56% 44% / 48% 60% 40% 52%;">
                        <Image
                            src={maria}
                            alt="Maria Montserrat seated in lotus pose on the grass"
                            widths={[420, 640, 820]}
                            sizes="(min-width: 768px) 40vw, 85vw"
                            class="h-[420px] w-full object-cover md:h-[520px]"
                            loading="eager"
                        />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================ FOUR CARDS ============================ -->
    <section class="relative overflow-hidden bg-secondary-100 py-14 md:py-20">
        <div class="relative mx-auto max-w-3xl px-6 md:px-10">
            <div class="mx-auto max-w-2xl text-center">
                <h2 class="font-display text-3xl leading-tight text-stone-900 sm:text-4xl">
                    Four ways to find me
                </h2>
                <p class="mt-4 leading-relaxed text-stone-600">
                    Whoever you are, there's a door for you.
                </p>
            </div>

            <!-- Link-tree style: one clickable row per destination, small
                 thumbnail on the left, a pill "button" on the right. -->
            <div class="mt-12 flex flex-col gap-5">
                {cards.map((c) => (
                    <a
                        href={c.href}
                        {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        class="group flex flex-col gap-5 rounded-3xl bg-sand-50 p-5 ring-1 ring-stone-900/5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-primary-900/10 sm:flex-row sm:items-center sm:gap-6 sm:p-6"
                    >
                        <Image
                            src={c.thumb}
                            alt={c.thumbAlt}
                            widths={[160, 240, 320]}
                            sizes="112px"
                            class="h-24 w-full shrink-0 rounded-2xl object-cover sm:h-28 sm:w-28"
                            loading="lazy"
                        />
                        <div class="flex flex-1 flex-col">
                            <p class="text-xs font-semibold uppercase tracking-[0.3em] text-primary-800">{c.tag}</p>
                            <h3 class="mt-2 font-display text-2xl text-stone-900">{c.title}</h3>
                            <p class="mt-2 leading-relaxed text-stone-600">{c.body}</p>
                        </div>
                        <span class="mt-2 inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-primary-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition group-hover:bg-primary-800 sm:mt-0">
                            {c.cta}
                            <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 01-1.414-1.414L13.586 11H4a1 1 0 110-2h9.586l-3.293-3.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                        </span>
                    </a>
                ))}
            </div>
        </div>
    </section>
</Layout>
